# Rust build output and rustfmt backups
/target/
*.rs.bk

# Local application databases (for XDG paths redirected into the checkout)
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# User-supplied mod inbox; keep only the directory placeholder
/mods/*
!/mods/.gitkeep

# Proton/DXVK/VKD3D diagnostics and shader caches created beside the launcher
/vkd3d-proton.cache
/vkd3d-proton.cache.write
/*.dxvk-cache
/steam-*.log
/*.dmp
/core
/core.*
/nohup.out

# makepkg output
/packaging/pkg/
/packaging/src/
/packaging/*.pkg.tar.*

# Local environment and editor state
/.env
/.env.*
!/.env.example
/.idea/
/.vscode/
/.agents/
/.codex/
.DS_Store
*.swp
*.swo
*~
